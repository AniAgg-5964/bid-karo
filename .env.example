# Local environment variables. Copy to .env and replace placeholders.
# Never commit real secrets.

APP_ENV=development
APP_NAME=BidKaro API
API_PREFIX=/api

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bidkaro

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend origin allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Local file storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# TinyFish (Phase 2). No live discovery runs without these.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=
TINYFISH_AGENT_TIMEOUT_SECONDS=120

# AI provider (Phase 3). Keep provider selection explicit.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
