# Local environment variables. Copy to .env and replace placeholders.
# Never commit real secrets.

APP_ENV=development
APP_NAME=BidKaro API
API_PREFIX=/api

# MongoDB
# Local default. For Atlas use the mongodb+srv:// URI shown under Atlas > Connect > Drivers,
# and percent-encode special characters in the password (for example @ -> %40).
# Atlas setup: database user with readWrite on this database, and your IP in Network Access.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bidkaro
MONGODB_APP_NAME=BidKaro
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_RETRY_WRITES=true

# One-time local -> Atlas copy only (scripts/migrate-to-atlas.py). Not read by the API.
# The app itself always uses MONGODB_URI.
ATLAS_MONGODB_URI=

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gmail SMTP for signup verification and sign-in OTP.
# Create a Google App Password (Google Account > Security > 2-Step Verification >
# App passwords) and put it here. Never use or commit the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=bidkaroindia@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=BidKaro
SMTP_TIMEOUT_SECONDS=20
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Frontend origin allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Local file storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# TinyFish (Phase 2). Required for live discovery.
# The API key is sent as the X-API-Key header; base URL defaults to https://agent.tinyfish.ai.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_AGENT_TIMEOUT_SECONDS=120

# Discovery tuning (Phase 2)
DISCOVERY_MAX_CANDIDATES=20
DISCOVERY_FETCH_LIMIT=12
DISCOVERY_MIN_SCORE=0.3
DISCOVERY_CACHE_HOURS=24

# AI provider (Phase 3). Keep provider selection explicit.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2000

# PDF text extraction and user-triggered requirement extraction (Phase 3).
PDF_MAX_PAGES=200
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MAX_PAGES=40
OCR_TIMEOUT_SECONDS=45
# Optional explicit path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
AI_EXTRACTION_MAX_CHUNK_CHARS=4000
AI_EXTRACTION_MAX_PAGES_PER_CHUNK=3
AI_EXTRACTION_MAX_CHUNKS=12
AI_EXTRACTION_MAX_PAGES=80

# Tender packages: a tender uploaded as the ZIP it was published as. The
# archive is expanded on the server under these limits.
PACKAGE_MAX_UPLOAD_MB=200
PACKAGE_MAX_MEMBERS=200
PACKAGE_MAX_MEMBER_MB=25
PACKAGE_MAX_EXPANDED_MB=500
PACKAGE_MAX_RATIO=200
PACKAGE_MAX_NESTING=1

# The job worker runs queued work (the analysis pipeline) in the API process.
JOB_WORKER_ENABLED=true
JOB_POLL_SECONDS=2

# Vector store (Qdrant) for semantic retrieval. Qdrant is an index only:
# documents, requirements and decisions stay in MongoDB and on disk.
# Start it with: scripts\qdrant-dev.ps1 start
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
# Only needed where the deployment authenticates the store.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=bidkaro_knowledge
QDRANT_TIMEOUT_SECONDS=10
# 0 means the vector size is taken from the embedding provider.
QDRANT_VECTOR_SIZE=0

# Embeddings. "hashing" is deterministic, needs no download and costs nothing.
# "model2vec" uses a small local semantic model that is downloaded once.
EMBEDDING_PROVIDER=hashing
# Empty means the provider's own default model.
EMBEDDING_MODEL=
# 0 means the provider's own dimension.
EMBEDDING_DIMENSION=0
EMBEDDING_BATCH_SIZE=32

# Retrieval and ingestion limits.
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNK_MAX_PER_DOCUMENT=2000
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0
