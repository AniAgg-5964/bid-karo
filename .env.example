# Local environment variables. Copy to .env and replace placeholders.
# Never commit real secrets.

APP_ENV=development
APP_NAME=BidKaro API
API_PREFIX=/api

# MongoDB
# Local default. For Atlas use the mongodb+srv:// URI shown under Atlas > Connect > Drivers,
# and percent-encode special characters in the password (for example @ -> %40).
# Atlas setup: database user with readWrite on this database, and your IP in Network Access.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bidkaro
MONGODB_APP_NAME=BidKaro
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_RETRY_WRITES=true

# One-time local -> Atlas copy only (scripts/migrate-to-atlas.py). Not read by the API.
# The app itself always uses MONGODB_URI.
ATLAS_MONGODB_URI=

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend origin allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Local file storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# TinyFish (Phase 2). Required for live discovery.
# The API key is sent as the X-API-Key header; base URL defaults to https://agent.tinyfish.ai.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_AGENT_TIMEOUT_SECONDS=120

# Discovery tuning (Phase 2)
DISCOVERY_MAX_CANDIDATES=20
DISCOVERY_FETCH_LIMIT=12
DISCOVERY_MIN_SCORE=0.3
DISCOVERY_CACHE_HOURS=24

# AI provider (Phase 3). Keep provider selection explicit.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2000

# PDF text extraction and user-triggered requirement extraction (Phase 3).
PDF_MAX_PAGES=200
AI_EXTRACTION_MAX_CHUNK_CHARS=4000
AI_EXTRACTION_MAX_PAGES_PER_CHUNK=3
AI_EXTRACTION_MAX_CHUNKS=12
AI_EXTRACTION_MAX_PAGES=80
